{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "$HOME/.config/images/logos/yuuka.png",
    "height": 18
  },
  "modules": [
    /*{
      "type": "command",
      "key": "->",
      "text": "splash=$(hyprctl splash);echo $splash"
    },*/
    {
      "type": "title",
      "key": "🧙🏻‍♀️"
    },
    "separator",
    {
      "type": "os",
      "key": "🤖 OS"
    },
    /*{
      "type": "host",
      "format": "{2}"
    },*/
    {
      "type": "kernel",
      "key": "🐧 Kernel"
    },
    {
      "type": "uptime",
      "key": "⌛ Uptime"
    },
    {
      "type": "packages",
      "key": "📦 Packages"
    },
    {
      "type": "shell",
      "key": "🐚 Shell"
    },
    {
      "type": "display",
      "key": "📺 Display"
    },
    "de",
    // "wmtheme",
    // "font",
    // "cursor",
    // "terminal",
    // "terminalfont",
    {
      "type": "custom",
      "format": "========================="
    },
    {
      "type": "cpu",
      "key": "⚙️ CPU"
    },
    {
      "type": "gpu",
      "key": "🎮 GPU"
    },
    {
      "type": "memory",
      "key": "🧠 Memory"
    },
    {
      "type": "swap",
      "key": "🧠 Swap"
    },
    {
      "type": "disk",
      "key": "💽 Disk"
    },
    {
      "type": "localip",
      "key": "📨 Local IP {2}"
    },
    {
      "type": "battery",
      "key": "🔋 Battery"
    },
    "poweradapter",
    "separator",
    {
      "type": "colors",
      "paddingLeft": 1,
      "symbol": "circle"
    }
  ]
}
